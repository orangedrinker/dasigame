-  return { notes, duration, beat: chartData.beat, lyrics }
+/** Forced alignment timestamps are absolute seconds within the audio file. */
+export type AnthemPhrase = {
+  start: number
+  end: number
+  text: string
+  chars?: Array<{ char: string; start: number; end: number }>
+}
+
+// Notes and aligned phrases store real recording-relative timestamps. Normalize
+// the note chart once at its vocal anchor; the shared AudioContext clock applies
+// the measured intro. Keep the negative prelude note playable.
+export function buildAnthem(): { notes: AnthemNote[]; duration: number; beat: number; lyrics: LyricChar[]; phrases: AnthemPhrase[] } {
+  const notes = (isBrief ? chartData.notes.filter((note) => note.time < 52) : chartData.notes)
+    .map((note) => ({ ...note, time: note.time - chartVocalOrigin }))
+  const phrases = isBrief ? phraseData.filter((phrase) => phrase.start < 52) : phraseData
+  const lyrics = phrases.flatMap((phrase, index) =>
+    (phrase.chars ?? Array.from(phrase.text, (char) => ({ char, start: phrase.start, end: phrase.end })))
+      .map((entry) => ({ char: entry.char, time: entry.start - introOffset, phrase: index })))
+  // The buffer is unchanged; finish at its real end rather than shifting its tail.
+  const duration = (isBrief ? 54 : chartData.duration) - introOffset
+  return { notes, duration, beat: chartData.beat, lyrics, phrases }
 }
 
 export class AnthemPlayer {
