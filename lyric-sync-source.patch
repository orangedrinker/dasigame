-export function buildAnthem(): { notes: AnthemNote[]; duration: number; beat: number; lyrics: LyricChar[] } {
-  const notes = isBrief ? chartData.notes.filter((note) => note.time < 52) : chartData.notes
-  const lyrics = isBrief ? chartData.lyrics.filter((entry) => entry.time < 52) : chartData.lyrics
